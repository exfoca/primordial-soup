# Baseline declarativo empacotado do Primordial Soup.
#
# Este arquivo é versionado e distribuído com o pacote. Contém apenas valores
# declarativos de inicialização/padrão; contratos e semântica permanecem no Python.
# Uma instalação pode selecionar um arquivo de configuração do usuário/override.
# Valores NON-HOT definem configurações de processo/modelo que não podem ser alteradas
# através de RuntimeRules enquanto uma simulação estiver em execução.
# Valores OPERATOR são padrões de inicialização para estado de execução/apresentação que
# podem ser alterados posteriormente pelo operador.
# Valores HOT definem padrões para um mundo novo. Uma vez que um mundo está em execução,
# state.runtime_rules é a autoridade.
# Um checkpoint restaura seu próprio estado de runtime e não deve ser silenciosamente
# sobrescrito por este arquivo.
# Valores derivados, fórmulas, domínios semânticos, contratos de validação, versões de
# schema e identificadores de compatibilidade pertencem ao Python.
# Nenhum segredo pertence aqui.
# Não há suporte para interpolação ou referências entre variáveis.

# =============================================================================
# NON-HOT — MUNDO / EXIBIÇÃO
# =============================================================================

# Largura lógica de exibição em pixels.
# Requer um novo processo para entrar em vigor.
SCREEN_WIDTH=1920

# Altura lógica de exibição em pixels.
# Requer um novo processo para entrar em vigor.
SCREEN_HEIGHT=1080

# Escala de renderização de célula lógica preferida.
TARGET_PIXEL_SCALE=4

# Multiplicador de zoom da câmera aplicado por passo de zoom.
ZOOM_STEP=1.20

# =============================================================================
# NON-HOT — POPULAÇÃO
# =============================================================================

# População inicial criada para cada linhagem.
INITIAL_POPULATION_PER_LINEAGE=50

# População viva máxima permitida por linhagem.
MAX_POPULATION_PER_LINEAGE=350

# =============================================================================
# NON-HOT — PERCEPÇÃO / ARQUITETURA NEURAL
# =============================================================================

# Raio da janela quadrada de percepção local.
VISION_RADIUS=5

# Largura da primeira camada oculta recorrente.
HIDDEN_NEURONS=25

# Largura da segunda camada oculta.
HIDDEN_NEURONS_2=12

# Ativação da primeira camada oculta.
HIDDEN_ACTIVATION=tanh

# Ativação da segunda camada oculta.
HIDDEN_ACTIVATION_2=tanh

# Ativação da camada de saída.
OUTPUT_ACTIVATION=linear

# HP inicial para fundadores e recém-nascidos.
INITIAL_HP=10000

# =============================================================================
# NON-HOT — GEOMETRIA DO MUNDO
# =============================================================================

NUMBER_OF_ZONES=8
ZONE_RADIUS=27

NEST_RADIUS=20
NEST_SPAWN_RADIUS=1
MAX_NEST_PLACEMENT_ATTEMPTS=10000

# =============================================================================
# NON-HOT — APRESENTAÇÃO
# =============================================================================

TARGET_FPS=60

HUD_FONT=monospace,14,true

HUD_BG_COLOR=8,10,14
HUD_BORDER_COLOR=60,70,85
HUD_TEXT_COLOR=220,230,240
HUD_TEXT_SECONDARY_COLOR=140,155,175
HUD_TITLE_COLOR=255,215,0

HUD_MARGIN=8
HUD_PADDING=10
HUD_TELEMETRY_WIDTH=400
HUD_OVERLAY_ALPHA=0
HUD_SECTION_GAP=8
HUD_DIVIDER_COLOR=40,48,60
HUD_KEY_BG_COLOR=18,21,27

CHART_INNER_PADDING=28

CHART_BG_COLOR=6,8,12
CHART_GRID_COLOR=26,32,42
CHART_AXIS_COLOR=90,100,115
CHART_LABEL_COLOR=170,185,200
CHART_TITLE_COLOR=230,240,250

HORIZONTAL_GRID_LINES=4
VERTICAL_GRID_LINES=5
CHART_LINE_THICKNESS=2

TRAIL_MAX_LENGTH=2000
TRAIL_COLOR_OLD=40
TRAIL_COLOR_NEW=240

DEATH_MARKER_TTL_TICKS=2000

INSPECTION_PANEL_WIDTH=320
INSPECTION_CELL_HEIGHT=8
CLICK_RADIUS_IN_CELLS=4

PANEL_BG_COLOR=10,10,10
PANEL_BORDER_COLOR=80,80,80
PANEL_TEXT_COLOR=230,230,230
PANEL_SECONDARY_TEXT_COLOR=160,160,160
INSPECTION_HIGHLIGHT_COLOR=255,255,0

HEATMAP_LIMIT=2.0

# =============================================================================
# NON-HOT — SELEÇÃO DE PERSISTÊNCIA
# =============================================================================

SAVE_SLOTS=default,world_a,world_b,world_c
DEFAULT_SAVE_SLOT=default

# =============================================================================
# NON-HOT — GRAVAÇÃO
# =============================================================================

RECORDING_FILE=primordial_soup.gif
RECORDING_FPS=15
RECORDING_MAX_FRAMES=400
RECORDING_SCALE=0.5
RECORDING_LOOP=0
RECORDING_COLORS=128

# =============================================================================
# NON-HOT — CALIBRAÇÃO DE ÁUDIO
# =============================================================================

SOUND_VOLUME_MUSIC=0.1
SOUND_VOLUME_SFX=1.0

# =============================================================================
# NON-HOT — DIAGNÓSTICOS / MÉTRICAS
# =============================================================================

PRINT_EVERY_N_TICKS=100
METRICS_HISTORY_SIZE=600
METRICS_INTERVAL=10

# =============================================================================
# PADRÕES DO OPERADOR
#
# Padrões de inicialização para estado de operador/execução.
# Estes não são RuntimeRules.
# =============================================================================

DEFAULT_LANGUAGE=en

DEFAULT_SIMULATION_SPEED=1.0

DEFAULT_PAUSED=true

DEFAULT_ZONES_ACTIVE=true

DEFAULT_FLOATING_HUD_VISIBLE=true

DEFAULT_MUSIC_ENABLED=true

DEFAULT_SFX_ENABLED=true

DEFAULT_DISCOVERY_CRITERION=most_evolved

DEFAULT_DISCOVERY_LINEAGE_FILTER=all

# =============================================================================
# HOT — GENÉTICA / CROSSOVER
#
# Linha de base para um novo objeto RuntimeRules.
# Alterações em runtime não reescrevem este arquivo.
# =============================================================================

HOT_CROSSOVER_MODE=blocks
HOT_CROSSOVER_PROBABILITY=0.5
HOT_BLOCK_SIZE=64

# =============================================================================
# HOT — MUTAÇÃO
# =============================================================================

HOT_MUTATION_MODE=two_scales
HOT_MUTATION_RATE=5
HOT_MUTATED_GENES=1

HOT_LOCAL_SCALE_FRACTION=5
HOT_LOCAL_SCALE_SIGMA=0.1

HOT_GLOBAL_PROBABILITY=10
HOT_GLOBAL_SCALE_FRACTION=20
HOT_GLOBAL_SCALE_SIGMA=1.0

# =============================================================================
# HOT — COMPORTAMENTO
# =============================================================================

HOT_LOW_HP_THRESHOLD=2000
HOT_STAY_STILL_IMPULSE=1.0
HOT_DEATH_HP_THRESHOLD=0

# =============================================================================
# HOT — ECOLOGIA
# =============================================================================

HOT_ZONE_HP_EFFECT=5
HOT_BASE_DECAY_PER_TICK=1
HOT_PREDATION_TRANSFER=100
HOT_DAMAGE_PER_OWN_OVERCROWDING=10

# =============================================================================
# HOT — REPRODUÇÃO
# =============================================================================

HOT_REPRODUCTION_INTERVAL=150
HOT_REPRODUCTION_MIN_AGE=5000
HOT_REPRODUCTION_HP_GATE=10000
HOT_REPRODUCTION_MIN_ENCOUNTERS=6
HOT_REPRODUCTION_PARENT_HP_BONUS=50

# =============================================================================
# HOT — SELEÇÃO
# =============================================================================

HOT_REPRODUCTION_CRITERION=composite
HOT_REPRODUCTION_POOL_FRACTION=0.9
HOT_REPRODUCTION_ATTEMPTS_DIVISOR=50
HOT_REPRODUCTION_MIN_SCORE=0.6

HOT_LONGEVITY_WEIGHT=0.3
HOT_EXPLORATION_WEIGHT=0.3
HOT_INTERACTION_WEIGHT=0.3
HOT_REPRODUCTION_WEIGHT=0.3
